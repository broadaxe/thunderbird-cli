# Normalize line endings for Linux-native text files.
* text=auto eol=lf

# Shell and system configuration
*.sh text eol=lf
*.bash text eol=lf
*.zsh text eol=lf
*.ksh text eol=lf
Makefile text eol=lf
*.mk text eol=lf
*.service text eol=lf
*.timer text eol=lf
*.conf text eol=lf
*.cfg text eol=lf
*.ini text eol=lf
*.desktop text eol=lf
